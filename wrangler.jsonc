{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pip",
  "account_id": "cae70b92e0d5130755abff25524a3f98",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d7fb78d46dc949d6ac39d96ccfb58ce2",
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://pip.e-ducare-org.workers.dev",
    "RESEND_FROM_EMAIL": "E-ducare PIP <noreply@pip.e-ducare.org>",
  },
  // Previews do not inherit the settings above. They share the production database.
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "d7fb78d46dc949d6ac39d96ccfb58ce2",
      },
    ],
    "vars": {
      "BETTER_AUTH_URL": "https://pip.e-ducare-org.workers.dev",
      "RESEND_FROM_EMAIL": "E-ducare PIP <noreply@pip.e-ducare.org>",
    },
  },
  "observability": {
    "enabled": true,
  },
}
