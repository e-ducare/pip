# Supabase signs its certificates with its own root CA. Download it from the
# dashboard's SSL configuration and point sslrootcert at the file.

# Session pooler for local dev
DATABASE_URL=postgresql://postgres.xxx:yyy@zzz.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt

# Transaction pooler for Serverless hosting, such as Vercel, port `6543`
# DATABASE_URL=postgresql://postgres.xxx:yyy@zzz.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/path/to/prod-ca-2021.crt

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=E-ducare PIP <noreply@pip.e-ducare.org>

# Google Drive uploads: service account with domain-wide delegation, acting as
# GOOGLE_DRIVE_IMPERSONATE (an org user who is a Content manager on the Shared Drive).
# Private key from the service account's JSON key, with newlines escaped as \n.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_IMPERSONATE=
