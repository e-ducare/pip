# Local development only. Wrangler loads this file as the Worker's secrets.

# Stands in for the Hyperdrive binding. supabase/prod-ca-2021.crt is the root CA
# that signs Supabase's certificates. The session pooler works on IPv4 networks.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.xxx:yyy@zzz.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=supabase/prod-ca-2021.crt

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=E-ducare PIP <noreply@pip.e-ducare.org>
